	<Rule id="R02">
		<description>if response time is violated, increase the number of VMs (vertical scaling)</description>
		<QualityAttribute>ResponseTime</QualityAttribute>
		<AdaptationTactic>VERTICAL_SCALING_NUM</AdaptationTactic>
		<priority>2</priority>
	</Rule>

	<Rule id="R03">
		<description>if response time is violated, increase the number of PMs (horizontal scaling)</description>
		<QualityAttribute>ResponseTime</QualityAttribute>
		<AdaptationTactic>HORIZONTAL_SCALING</AdaptationTactic>
		<priority>3</priority>
	</Rule> 

