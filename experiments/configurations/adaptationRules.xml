	<Rule id="R08">
		<description>if energy consumption is violated, decrease the number of VMs (vertical de-scaling)</description>
		<QualityAttribute>EnergyConsumption</QualityAttribute>
		<AdaptationTactic>VERTICAL_DESCALING_NUM</AdaptationTactic>
		<priority>2</priority>
	</Rule>

	<Rule id="R09">
		<description>if energy consumption is violated, decrease the number of PMs (horizontal de-scaling)</description>
		<QualityAttribute>EnergyConsumption</QualityAttribute>
		<AdaptationTactic>HORIZONTALL_DESCALING</AdaptationTactic>
		<priority>3</priority>
	</Rule>

	<Rule id="R10">
		<description>if operational cost is violated, decrease the number of VMs (vertical de-scaling)</description>
		<QualityAttribute>OperationalCost</QualityAttribute>
		<AdaptationTactic>VERTICAL_DESCALING_NUM</AdaptationTactic>
		<priority>1</priority>
	</Rule>

	<Rule id="R11">
		<description>if operational cost is violated, decrease the number of PMs (horizontal de-scaling)</description>
		<QualityAttribute>OperationalCost</QualityAttribute>
		<AdaptationTactic>HORIZONTALL_DESCALING</AdaptationTactic>
		<priority>2</priority>
	</Rule> 
	
</AdaptationRules>
