	<QualityAttribute id="QA03">
		<name>EnergyConsumption</name>
		<constraintValue>25</constraintValue>
		<metric>kWh</metric>
		<isMin>true</isMin>
		<weight>1.0</weight>
		<threshold>15</threshold>
	</QualityAttribute>

	<QualityAttribute id="QA04">
		<name>OperationalCost</name>
		<constraintValue>50</constraintValue>
		<metric>$</metric>
		<isMin>true</isMin>
		<weight>1.0</weight>
		<threshold>10</threshold>
	</QualityAttribute>

</QoSGoals>