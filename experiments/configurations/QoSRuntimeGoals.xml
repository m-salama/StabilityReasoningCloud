<?xml version="1.0" encoding="UTF-8"?>
<QoSGoals>
	<QualityAttribute id="QA01">
		<name>ResponseTime</name>
		<constraintValue>25</constraintValue>
		<metric>ms</metric>
		<isMin>true</isMin>
		<weight>1.0</weight>
		<threshold>20</threshold>
	</QualityAttribute>

